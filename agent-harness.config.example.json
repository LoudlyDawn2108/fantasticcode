{
  "version": 1,
  "defaults": {
    "model": "openai/gpt-4.1",
    "agent": "coder"
  },
  "providers": {
    "openai": {
      "sdk": "openai",
      "baseUrl": "https://api.openai.com/v1",
      "apiKeyEnv": "OPENAI_API_KEY",
      "defaultModel": "gpt-4.1",
      "models": {
        "gpt-4.1": {
          "id": "gpt-4.1",
          "displayName": "GPT-4.1"
        },
        "gpt-4.1-mini": {
          "id": "gpt-4.1-mini",
          "displayName": "GPT-4.1 mini"
        }
      }
    }
  }
}
