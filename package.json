{
  "name": "fantasticcode",
  "version": "0.1.0",
  "description": "A scriptable TypeScript CLI harness for coding agents.",
  "type": "module",
  "bin": {
    "fantasticcode": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "agents",
    "README.md",
    "docs"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "qa": "npm run typecheck && npm test -- --run && npm run build && npm pack --dry-run && node dist/cli.js --help"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "better-sqlite3": "^12.10.0",
    "commander": "^14.0.2",
    "openai": "^6.42.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14"
  },
  "license": "MIT"
}
